# 이 파일을 .env 로 복사하고 키를 넣으세요.
ANTHROPIC_API_KEY=
# 사용할 Claude 모델 (기본: claude-opus-5-5)
# CLAUDE_MODEL=claude-haiku-5-5  (더 정확하게: claude-opus-5-5)
# DB 파일 위치 (기본: data/app.db)
# APP_DB=data/app.db

# 분류 확인 거래 추측: agent = Console 에이전트(아래 버전), 실패하면 기존 API로 대신
# GUESS_ENGINE=agent
# AGENT_VERSION=8
# GUESS_SCOPE=all  (나간 돈 전부를 에이전트에, 기본은 애매한 거래만)

# 주간 보고서: agent = Console 보고서 에이전트, 실패하면 기존 API로 대신
# REPORT_ENGINE=agent
# REPORT_AGENT_VERSION=3
